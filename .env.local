# ============================================
# Flowo — Environment Variables Reference
# ============================================
#
# IMPORTANT: There are TWO places for configuration:
#
# 1. THIS FILE (.env) — Client-side variables only (VITE_ prefix)
#    These are bundled into the frontend at build time.
#
# 2. SUPABASE EDGE FUNCTION SECRETS — All private API keys
#    Set these at: https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/functions
#    NEVER put private API keys in this .env file.
#
# ============================================

# ----- Supabase (auto-populated by Lovable) -----
VITE_SUPABASE_URL=https://rmqisvutyndlzpqcwyym.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_q8tXRrdCWM2qHp_6RrMvRg_NQTkO_dW
VITE_SUPABASE_PROJECT_ID=rmqisvutyndlzpqcwyym


# ----- Feature Flags (set to "true" to enable) -----
# These toggle between real API calls and simulated/dummy data.
# You must ALSO add the corresponding API keys as Supabase secrets.
VITE_AI_ENABLED=false
VITE_STRIPE_ENABLED=false
VITE_TRENDS_ENABLED=false

# ----- Stripe (publishable key only — safe for client) -----
VITE_STRIPE_PUBLISHABLE_KEY=

# ----- App -----
VITE_APP_URL=http://localhost:8080

# ============================================
# SUPABASE EDGE FUNCTION SECRETS
# ============================================
# Add these via Supabase Dashboard > Settings > Edge Functions > Secrets
# DO NOT put them in this file.
#
# --- AI (required for VITE_AI_ENABLED=true) ---
# OPENAI_API_KEY=sk-...
#
# --- Stripe (required for billing) ---
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
# STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
# STRIPE_PRO_MONTHLY_PRICE_ID=price_...
# STRIPE_PRO_ANNUAL_PRICE_ID=price_...
# STRIPE_AGENCY_MONTHLY_PRICE_ID=price_...
# STRIPE_AGENCY_ANNUAL_PRICE_ID=price_...
#
# --- Social Platform OAuth (required for connecting accounts) ---
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=https://yourdomain.com/oauth/callback
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_REDIRECT_URI=https://yourdomain.com/oauth/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=https://yourdomain.com/oauth/callback
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# TWITTER_REDIRECT_URI=https://yourdomain.com/oauth/callback
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://yourdomain.com/oauth/callback
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=
# PINTEREST_REDIRECT_URI=https://yourdomain.com/oauth/callback
#
# --- Token Encryption (for securing stored OAuth tokens) ---
# TOKEN_ENCRYPTION_KEY=  (generate with: openssl rand -base64 32)
#
# --- Email (optional — for team invite emails) ---
# RESEND_API_KEY=re_...
